{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:food-help:dataset:v1",
  "title": "Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "dataset_id",
    "content_language",
    "taxonomy_version",
    "organizations",
    "resources"
  ],
  "properties": {
    "format": {
      "const": "food-help"
    },
    "schema_version": {
      "const": 1
    },
    "taxonomy_version": {
      "const": 1
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "content_language": {
      "$ref": "#/$defs/language"
    },
    "deployment_id": {
      "$ref": "#/$defs/id"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compatibility_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "data_updated_on": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/date"
        }
      ]
    },
    "organizations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "description": {
            "$ref": "#/$defs/text"
          },
          "url": {
            "$ref": "#/$defs/url"
          },
          "content_language": {
            "$ref": "#/$defs/language"
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "texts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "url": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opens",
        "closes"
      ],
      "properties": {
        "opens": {
          "$ref": "#/$defs/time"
        },
        "closes": {
          "$ref": "#/$defs/time"
        },
        "closes_next_day": {
          "type": "boolean"
        }
      }
    },
    "time": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "intervals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interval"
      }
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "state": {
      "enum": [
        "yes",
        "no",
        "unknown"
      ],
      "type": "string"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "organization_id",
        "name",
        "summary",
        "categories",
        "food_access_purpose",
        "access",
        "eligibility",
        "limitations",
        "before_you_go",
        "schedule",
        "evidence",
        "verification",
        "publication_status",
        "service_condition",
        "updated_on"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "organization_id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "food_access_purpose": {
          "$ref": "#/$defs/text"
        },
        "content_language": {
          "$ref": "#/$defs/language"
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "prepared_meals",
              "food_banks_pantries",
              "groceries",
              "community_fridges",
              "community_markets",
              "community_gardens",
              "food_delivery",
              "food_access_support",
              "other_food_access"
            ],
            "type": "string"
          }
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description"
          ],
          "properties": {
            "description": {
              "$ref": "#/$defs/text"
            },
            "address": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "street",
                "locality",
                "region",
                "country"
              ],
              "properties": {
                "street": {
                  "$ref": "#/$defs/text"
                },
                "locality": {
                  "$ref": "#/$defs/text"
                },
                "region": {
                  "$ref": "#/$defs/text"
                },
                "country": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                },
                "postal_code": {
                  "$ref": "#/$defs/text"
                },
                "neighbourhood": {
                  "$ref": "#/$defs/text"
                }
              }
            },
            "coordinates": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "latitude",
                "longitude"
              ],
              "properties": {
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              }
            }
          }
        },
        "service_area": {
          "$ref": "#/$defs/text"
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{4,14}$"
        },
        "phone_extension": {
          "type": "string",
          "pattern": "^[0-9]{1,8}$"
        },
        "official_url": {
          "$ref": "#/$defs/url"
        },
        "time_zone": {
          "$ref": "#/$defs/text"
        },
        "service_languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/language"
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "walk_in",
            "appointment_required",
            "registration_required",
            "identification_required",
            "details"
          ],
          "properties": {
            "walk_in": {
              "$ref": "#/$defs/state"
            },
            "appointment_required": {
              "$ref": "#/$defs/state"
            },
            "registration_required": {
              "$ref": "#/$defs/state"
            },
            "identification_required": {
              "$ref": "#/$defs/state"
            },
            "details": {
              "$ref": "#/$defs/texts"
            }
          }
        },
        "eligibility": {
          "$ref": "#/$defs/texts"
        },
        "limitations": {
          "$ref": "#/$defs/texts"
        },
        "before_you_go": {
          "$ref": "#/$defs/texts"
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "description"
          ],
          "properties": {
            "state": {
              "enum": [
                "free",
                "low_cost",
                "subsidized",
                "mixed",
                "unknown"
              ],
              "type": "string"
            },
            "description": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "confirmed",
            "note",
            "weekly",
            "exceptions",
            "evidence_ids"
          ],
          "properties": {
            "kind": {
              "enum": [
                "weekly",
                "dated",
                "by_arrangement",
                "unknown"
              ],
              "type": "string"
            },
            "confirmed": {
              "type": "boolean"
            },
            "note": {
              "$ref": "#/$defs/text"
            },
            "valid_from": {
              "$ref": "#/$defs/date"
            },
            "valid_to": {
              "$ref": "#/$defs/date"
            },
            "evidence_ids": {
              "$ref": "#/$defs/evidence_ids"
            },
            "weekly": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "day",
                  "state",
                  "intervals"
                ],
                "properties": {
                  "day": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 7
                  },
                  "state": {
                    "enum": [
                      "published",
                      "closed",
                      "unknown"
                    ],
                    "type": "string"
                  },
                  "intervals": {
                    "$ref": "#/$defs/intervals"
                  }
                }
              }
            },
            "exceptions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "date",
                  "confirmed",
                  "intervals",
                  "note",
                  "evidence_ids"
                ],
                "properties": {
                  "date": {
                    "$ref": "#/$defs/date"
                  },
                  "confirmed": {
                    "type": "boolean"
                  },
                  "intervals": {
                    "$ref": "#/$defs/intervals"
                  },
                  "note": {
                    "$ref": "#/$defs/text"
                  },
                  "evidence_ids": {
                    "$ref": "#/$defs/evidence_ids"
                  }
                }
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source_kind",
              "checked_on",
              "note",
              "supports"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "source_kind": {
                "enum": [
                  "provider",
                  "direct_confirmation",
                  "local_authority",
                  "referral_directory",
                  "other_reviewed"
                ],
                "type": "string"
              },
              "url": {
                "$ref": "#/$defs/url"
              },
              "checked_on": {
                "$ref": "#/$defs/date"
              },
              "note": {
                "$ref": "#/$defs/text"
              },
              "supports": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewed_on",
            "method",
            "state"
          ],
          "properties": {
            "reviewed_on": {
              "$ref": "#/$defs/date"
            },
            "method": {
              "enum": [
                "provider_source",
                "direct_confirmation",
                "multiple_sources",
                "other_reviewed"
              ],
              "type": "string"
            },
            "state": {
              "enum": [
                "confirmed",
                "partially_confirmed",
                "needs_review"
              ],
              "type": "string"
            }
          }
        },
        "publication_status": {
          "enum": [
            "draft",
            "published",
            "withdrawn"
          ],
          "type": "string"
        },
        "service_condition": {
          "enum": [
            "active",
            "temporarily_changed",
            "temporarily_unavailable",
            "closed"
          ],
          "type": "string"
        },
        "updated_on": {
          "$ref": "#/$defs/date"
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text",
              "starts_on",
              "evidence_ids"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "$ref": "#/$defs/text"
              },
              "starts_on": {
                "$ref": "#/$defs/date"
              },
              "ends_on": {
                "$ref": "#/$defs/date"
              },
              "evidence_ids": {
                "$ref": "#/$defs/evidence_ids"
              }
            }
          }
        },
        "external_identifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "value"
            ],
            "properties": {
              "namespace": {
                "$ref": "#/$defs/url"
              },
              "value": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    }
  }
}
