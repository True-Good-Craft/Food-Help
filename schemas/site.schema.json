{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:food-help:site:v1",
  "title": "Site",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deployment_id",
    "community",
    "site_name",
    "description",
    "language",
    "locale",
    "text_direction",
    "time_zone",
    "canonical_origin",
    "operator",
    "corrections",
    "help_contact",
    "emergency_contact",
    "review",
    "data_rights",
    "example_content"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "deployment_id": {
      "$ref": "#/$defs/slug"
    },
    "community": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "locality",
        "region",
        "country"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "locality": {
          "$ref": "#/$defs/text"
        },
        "region": {
          "$ref": "#/$defs/text"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      }
    },
    "site_name": {
      "$ref": "#/$defs/text"
    },
    "short_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "description": {
      "$ref": "#/$defs/text"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]+)*$"
    },
    "locale": {
      "$ref": "#/$defs/text"
    },
    "text_direction": {
      "enum": [
        "ltr",
        "rtl"
      ],
      "type": "string"
    },
    "time_zone": {
      "$ref": "#/$defs/text"
    },
    "canonical_origin": {
      "$ref": "#/$defs/https"
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "$ref": "#/$defs/https"
        },
        "statement": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "corrections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "email"
      ],
      "properties": {
        "email": {
          "type": "string",
          "pattern": "^[^\\s@<>]+@[^\\s@<>]+\\.[^\\s@<>]+$"
        }
      }
    },
    "help_contact": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/contact"
        }
      ]
    },
    "emergency_contact": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/contact"
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval_days"
      ],
      "properties": {
        "interval_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "introduction": { "$ref": "#/$defs/text" },
        "category_groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "categories"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "label": { "type": "string", "minLength": 1, "maxLength": 80 },
              "categories": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[a-z]+(?:_[a-z]+)*$", "maxLength": 80 }
              }
            }
          }
        }
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logo": {
          "$ref": "#/$defs/asset"
        },
        "icon_192": {
          "$ref": "#/$defs/asset"
        },
        "icon_512": {
          "$ref": "#/$defs/asset"
        },
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": {
              "$ref": "#/$defs/color"
            },
            "background": {
              "$ref": "#/$defs/color"
            },
            "text": {
              "$ref": "#/$defs/color"
            }
          }
        }
      }
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_through",
        "warning_dates"
      ],
      "properties": {
        "coverage_through": {
          "$ref": "#/$defs/date"
        },
        "warning_dates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "note",
              "source_url",
              "checked_on"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              },
              "note": {
                "$ref": "#/$defs/text"
              },
              "source_url": {
                "$ref": "#/$defs/https"
              },
              "checked_on": {
                "$ref": "#/$defs/date"
              }
            }
          }
        }
      }
    },
    "analytics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "$ref": "#/$defs/https"
        },
        "collection_mode": {
          "enum": [
            "opt_in",
            "opt_out"
          ],
          "type": "string"
        },
        "disclosure": {
          "$ref": "#/$defs/text"
        },
        "constants": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "event_names": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "page_start": {
              "$ref": "#/$defs/text"
            },
            "call": {
              "$ref": "#/$defs/text"
            },
            "help": {
              "$ref": "#/$defs/text"
            },
            "directions": {
              "$ref": "#/$defs/text"
            },
            "source": {
              "$ref": "#/$defs/text"
            },
            "install": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "preference_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" },
        "content_type": { "enum": ["application/json", "text/plain;charset=UTF-8"], "type": "string" },
        "click_keepalive": { "type": "boolean" },
        "event_payloads": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "page_start": { "$ref": "#/$defs/eventPayload" },
            "call": { "$ref": "#/$defs/eventPayload" },
            "help": { "$ref": "#/$defs/eventPayload" },
            "directions": { "$ref": "#/$defs/eventPayload" },
            "source": { "$ref": "#/$defs/eventPayload" },
            "install": { "$ref": "#/$defs/eventPayload" }
          }
        },
        "attribution": {
          "type": "object", "additionalProperties": false,
          "required": ["events", "sources", "campaigns", "contents", "referrers", "internal_hosts"],
          "properties": {
            "events": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["page_start", "call", "help", "directions", "source"] } },
            "sources": { "$ref": "#/$defs/analyticsLabels" },
            "campaigns": { "$ref": "#/$defs/analyticsLabels" },
            "contents": { "$ref": "#/$defs/analyticsLabels" },
            "internal_hosts": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "$ref": "#/$defs/analyticsHost" } },
            "referrers": {
              "type": "array", "maxItems": 24,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["host", "source"],
                "properties": { "host": { "$ref": "#/$defs/analyticsHost" }, "source": { "$ref": "#/$defs/analyticsLabel" }, "include_subdomains": { "type": "boolean" } }
              }
            }
          }
        }
      }
    },
    "public_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "file": {
          "const": "usage.json"
        }
      }
    },
    "indexing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "example_content": {
      "type": "boolean"
    },
    "data_rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/text"
        },
        "license": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "$ref": "#/$defs/https"
        }
      }
    },
    "software_source_url": {
      "$ref": "#/$defs/https"
    }
  },
  "$defs": {
    "analyticsLabel": { "type": "string", "pattern": "^[a-z0-9_]{1,80}$" },
    "analyticsLabels": { "type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": { "$ref": "#/$defs/analyticsLabel" } },
    "analyticsHost": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$" },
    "eventPayload": { "type": "object", "minProperties": 1, "maxProperties": 8, "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,79}$" }, "additionalProperties": { "type": ["string", "number", "boolean"], "maxLength": 200 } },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "https": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "asset": {
      "type": "string",
      "pattern": "^assets/[A-Za-z0-9_-]+\\.(svg|png)$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "phone"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/text"
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+?[0-9]{2,15}$"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "source_url": {
          "$ref": "#/$defs/https"
        },
        "checked_on": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "deployment_id",
        "period_start",
        "period_end",
        "generated_at",
        "counts"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "deployment_id": {
          "$ref": "#/$defs/slug"
        },
        "period_start": {
          "$ref": "#/$defs/date"
        },
        "period_end": {
          "$ref": "#/$defs/date"
        },
        "generated_at": {
          "$ref": "#/$defs/date"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "page_starts",
            "call_actions",
            "directions_actions",
            "source_link_actions",
            "installation_signals"
          ],
          "properties": {
            "page_starts": {
              "$ref": "#/$defs/count"
            },
            "call_actions": {
              "$ref": "#/$defs/count"
            },
            "directions_actions": {
              "$ref": "#/$defs/count"
            },
            "source_link_actions": {
              "$ref": "#/$defs/count"
            },
            "installation_signals": {
              "$ref": "#/$defs/count"
            }
          }
        }
      }
    },
    "count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
